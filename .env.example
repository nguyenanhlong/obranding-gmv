# Nguồn dữ liệu: mock (mặc định) hoặc api
DATA_SOURCE=mock

# Chỉ cần khi DATA_SOURCE=api
REPORT_API_BASE_URL=https://api.example.com
REPORT_API_TOKEN=

# Webhook revalidate gọi từ BE: POST /api/reports/revalidate
# header: x-revalidate-secret
REVALIDATE_SECRET=change-me-in-production

# Deploy (chỉ dùng trong CI, không commit giá trị thật)
# VERCEL_TOKEN=
